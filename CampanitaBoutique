<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Campanita Boutique</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400;1,600&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{--bg:#000;--card:#141414;--line:#2a2418;--gold:#c8a24c;--txt:#f1ece0;--mut:#9b9484;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--txt);font:italic 1.15rem/1.5 'Cormorant Garamond',Georgia,'Times New Roman',serif}
header{text-align:center;padding:40px 16px 24px;border-bottom:1px solid var(--line)}
#brand{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
#brand{flex-direction:column;gap:10px}#brand img{height:clamp(170px,42vw,280px);max-width:96%;object-fit:contain}
h1{margin:0;color:var(--gold);font:400 clamp(2.4rem,8vw,4rem)/1.1 'Great Vibes','Cormorant Garamond',cursive}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}#tag{color:var(--mut);margin:8px 0 0;font-style:italic}
.mono{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border:1px solid var(--gold);color:var(--gold);border-radius:50%;font-size:1.6rem}
main{max-width:1100px;margin:0 auto;padding:28px 16px}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}
.ph{aspect-ratio:1;background:#0f0f0f;display:flex;align-items:center;justify-content:center}
.ph img{width:100%;height:100%;object-fit:cover}.ph .mono{width:80px;height:80px;font-size:2.2rem}
.b{padding:14px}.b h3{margin:0 0 4px;font:italic 600 1.35rem 'Cormorant Garamond',Georgia,serif}
.b p{margin:0 0 10px;color:var(--mut);font-size:.9rem}
.pr{color:var(--gold);font-size:1.25rem;letter-spacing:.04em}
.empty{text-align:center;color:var(--mut)}.tabs{display:flex;gap:8px;padding:0 0 22px;justify-content:center;flex-wrap:wrap}.tabs button{font:italic 1.15rem 'Cormorant Garamond',Georgia,serif;padding:5px 18px;border-radius:99px}.tabs button.on{background:var(--gold);color:#111}
footer{text-align:center;padding:24px;color:var(--mut)}
footer button{background:none;border:0;color:#5c5648;cursor:pointer;font:inherit;font-size:.8rem}
#adm{position:fixed;inset:0;background:rgba(0,0,0,.88);overflow:auto;z-index:9;padding:calc(16px + env(safe-area-inset-top,0px)) 12px calc(16px + env(safe-area-inset-bottom,0px))}
#adm[hidden]{display:none}
.pan{max-width:560px;margin:0 auto;background:var(--card);border:1px solid var(--gold);border-radius:10px;padding:18px}
.pan h2,.pan h3{color:var(--gold);font-weight:400;margin:18px 0 8px}.pan h2{margin:0}
.row,.li{display:flex;justify-content:space-between;align-items:center;gap:8px}
.li{border-bottom:1px solid var(--line);padding:8px 0;font-size:.9rem}
label{display:block;margin:8px 0;color:var(--mut);font-size:.85rem}
input,textarea,select{display:block;width:100%;margin-top:4px;padding:9px;background:#0c0c0c;color:var(--txt);border:1px solid var(--line);border-radius:6px;font:inherit}
button{background:#1d1a12;color:var(--gold);border:1px solid var(--gold);border-radius:6px;padding:8px 12px;cursor:pointer;font:inherit;font-size:.85rem;margin:4px 4px 4px 0}
button.gold{background:var(--gold);color:#111}.warn{color:#e8b04a;font-size:.85rem}
</style></head><body>
<div id="root"></div>
<script id="data" type="application/json" data-keep>{"name":"Campanita Boutique","tagline":"Estilo, fragancia y encanto","logo":"data:image/jpeg;base64,","cats":["Categoría 1","Categoría 2","Categoría 3"],"hash":"befb21055ca4294696e4874a4ea04ec3d11d6603aea1f257697ef234f6f1e843","products":[{"id":"p1","cat":"Categoría 1","name":"Producto de ejemplo","desc":"Descripción breve del producto.","price":120000,"img":""},{"id":"p2","cat":"Categoría 2","name":"Otro producto","desc":"Edítalo o elimínalo desde el panel Admin.","price":85000,"img":""},{"id":"p3","cat":"Categoría 3","name":"Tercer producto","desc":"Agrega tus fotos reales.","price":45000,"img":""}]}</script>
<script data-keep>
let S=JSON.parse(document.getElementById('data').textContent),admin=false,dirty=false,editing=null,A=null,AS=null,canEdit=false;
const $=s=>document.querySelector(s);
const esc=t=>String(t==null?'':t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const money=n=>'$ '+Number(n||0).toLocaleString('es-CO');
async function sha(t){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
async function shrink(f){const bm=await createImageBitmap(f),r=Math.min(1,1000/Math.max(bm.width,bm.height)),c=document.createElement('canvas');c.width=Math.round(bm.width*r);c.height=Math.round(bm.height*r);c.getContext('2d').drawImage(bm,0,0,c.width,c.height);return new Promise(ok=>c.toBlob(ok,'image/jpeg',.85))}
async function up(f){if(!AS)throw new Error('Sin permiso para subir imágenes.');return(await AS.upload(await shrink(f))).url}
let cur='';
const list=()=>cur?S.products.filter(p=>p.cat===cur):S.products;
const tabs=()=>S.cats.length?`<div class="tabs"><button class="${cur?'':'on'}" onclick="cur='';draw()">Todo</button>${S.cats.map((c,i)=>`<button class="${cur===c?'on':''}" onclick="cur=S.cats[${i}];draw()">${esc(c)}</button>`).join('')}</div>`:'';
function draw(){
$('#root').innerHTML=`<header><div id="brand">${S.logo?`<img src="${esc(S.logo)}" alt="">`:`<span class="mono">${esc((S.name||'?')[0])}</span>`}<h1${S.logo?' class="sr"':''}>${esc(S.name)}</h1></div><p id="tag"${S.logo?' hidden':''}>${esc(S.tagline)}</p></header>
<main>${tabs()}<div id="grid">${list().length?list().map(p=>`<article class="card"><div class="ph">${p.img?`<img loading="lazy" src="${esc(p.img)}" alt="${esc(p.name)}">`:`<span class="mono">${esc((p.name||'?')[0])}</span>`}</div><div class="b"><h3>${esc(p.name)}</h3><p>${esc(p.desc)}</p><div class="pr">${money(p.price)}</div></div></article>`).join(''):'<p class="empty">Pronto nuevos productos.</p>'}</div></main>
<footer><button onclick="openA()">Admin</button></footer><div id="adm" hidden></div>`;
if(admin){$('#adm').hidden=false;panel()}}
function openA(){$('#adm').hidden=false;admin?panel():login()}
function closeA(){$('#adm').hidden=true}
function login(msg){$('#adm').innerHTML=`<div class="pan"><h2>Acceso Admin</h2><label>Código<input id="code" type="password"></label><p class="warn">${msg||''}</p><button class="gold" onclick="enter()">Entrar</button><button onclick="closeA()">Cancelar</button></div>`}
async function enter(){if(await sha($('#code').value)===S.hash){admin=true;panel()}else login('Código incorrecto.')}
function panel(){const e=editing?S.products.find(p=>p.id===editing):null;
$('#adm').innerHTML=`<div class="pan"><div class="row"><h2>Panel Admin</h2><button onclick="closeA()">Cerrar</button></div>
${dirty?'<p class="warn">Hay cambios sin publicar.</p>':''}<button class="gold" onclick="save()">Guardar y publicar cambios</button><span id="msg" class="warn"></span>
<h3>Datos del local</h3><label>Nombre<input id="sn" value="${esc(S.name)}"></label><label>Eslogan<input id="st" value="${esc(S.tagline)}"></label><label>Logo<input type="file" id="sl" accept="image/*"></label><button onclick="saveInfo()">Actualizar datos</button>
<h3>${e?'Editar':'Nuevo'} producto</h3><label>Nombre<input id="pn" value="${esc(e&&e.name)}"></label><label>Precio (COP)<input id="pp" type="number" value="${e?e.price:''}"></label><label>Descripción<textarea id="pd">${esc(e&&e.desc)}</textarea></label><label>Categoría<select id="pc"><option value="">Sin categoría</option>${S.cats.map(c=>`<option ${e&&e.cat===c?'selected':''}>${esc(c)}</option>`).join('')}</select></label><label>Foto${e&&e.img?' (deja vacío para conservar la actual)':''}<input type="file" id="pf" accept="image/*"></label>
<button class="gold" onclick="saveProd()">${e?'Guardar producto':'Agregar producto'}</button>${e?'<button onclick="editing=null;panel()">Cancelar</button>':''}
<h3>Productos (${S.products.length})</h3>${S.products.map(p=>`<div class="li"><span>${esc(p.name)} — ${money(p.price)}</span><span><button onclick="editing='${p.id}';panel()">Editar</button><button onclick="del('${p.id}')">Eliminar</button></span></div>`).join('')}
<h3>Categorías</h3>${S.cats.map((c,i)=>`<div class="li"><input id="k${i}" value="${esc(c)}"><span><button onclick="renCat(${i})">Guardar</button><button onclick="delCat(${i})">Eliminar</button></span></div>`).join('')}<label>Nueva categoría<input id="nk"></label><button onclick="addCat()">Agregar categoría</button>
<h3>Código de acceso</h3><label>Nuevo código<input id="nc" type="password"></label><button onclick="chCode()">Cambiar código</button></div>`}
function addCat(){const v=$('#nk').value.trim();if(!v||S.cats.includes(v))return say('Nombre vacío o repetido.');S.cats.push(v);dirty=true;draw()}
function renCat(i){const v=$('#k'+i).value.trim(),o=S.cats[i];if(!v)return;S.products.forEach(p=>{if(p.cat===o)p.cat=v});if(cur===o)cur=v;S.cats[i]=v;dirty=true;draw()}
function delCat(i){const o=S.cats[i];S.products.forEach(p=>{if(p.cat===o)p.cat=''});if(cur===o)cur='';S.cats.splice(i,1);dirty=true;draw()}
const say=t=>{const m=$('#msg');if(m)m.textContent=' '+t};
async function saveInfo(){try{S.name=$('#sn').value.trim()||S.name;S.tagline=$('#st').value.trim();const f=$('#sl').files[0];if(f)S.logo=await up(f);dirty=true;draw()}catch(e){say(e.message||'Error')}}
async function saveProd(){try{const n=$('#pn').value.trim();if(!n)return say('Falta el nombre.');const f=$('#pf').files[0],img=f?await up(f):'',p=editing&&S.products.find(x=>x.id===editing);
if(p){Object.assign(p,{cat:$('#pc').value,name:n,price:+$('#pp').value||0,desc:$('#pd').value.trim()});if(img)p.img=img}else S.products.unshift({id:'p'+Date.now(),cat:$('#pc').value,name:n,price:+$('#pp').value||0,desc:$('#pd').value.trim(),img});
editing=null;dirty=true;draw()}catch(e){say(e.message||'Error')}}
let pend=null;
function del(id){if(pend!==id){pend=id;return say('Pulsa Eliminar otra vez para confirmar.')}pend=null;S.products=S.products.filter(p=>p.id!==id);dirty=true;draw()}
async function chCode(){const v=$('#nc').value;if(v.length<4)return say('Mínimo 4 caracteres.');S.hash=await sha(v);dirty=true;say('Código cambiado; publica para guardarlo.')}
async function save(){if(!A||!canEdit)return say('Tu cuenta no tiene permiso de edición.');
const c=document.documentElement.cloneNode(true);c.querySelector('#root').innerHTML='';c.querySelector('#data').textContent=JSON.stringify(S).replace(/</g,'\\u003c');c.querySelectorAll('script:not([data-keep])').forEach(s=>s.remove());
try{say('Publicando…');await A.publish('<!doctype html>\n'+c.outerHTML)}catch(e){say('No se pudo publicar: '+(e.code||e.message))}}
draw();
(async()=>{try{if(!window.claude)return;const u=await claude.use('user');canEdit=!!(u&&u.canEdit());A=await claude.use('artifact');AS=await claude.use('assets')}catch(e){}})();
</script></body></html>
